<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="480.0"
      prefWidth="640.0"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/25.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hospital_room_manager.SecondaryController">

    <padding>
        <Insets top="40" right="60" bottom="40" left="60"/>
    </padding>

    <Label text="Hospital Room Manager"
           style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <Label text="Dashboard"
           style="-fx-font-size: 20px;"/>

    <Label text="You logged in successfully."/>

    <Button text="Patient Management"
            maxWidth="300"
            onAction="#openPatientManagement"/>

    <Button text="Room Management"
            maxWidth="300"
            onAction="#openRoomManagement"/>

    <Label text="Patient-to-Staff Assignments"/>

    <Button text="Log Out"
            maxWidth="200"
            onAction="#switchToPrimary"/>
</VBox>