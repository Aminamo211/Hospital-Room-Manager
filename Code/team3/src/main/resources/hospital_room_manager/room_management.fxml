<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="480.0"
            prefWidth="640.0"
            xmlns="http://javafx.com/javafx/25.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hospital_room_manager.RoomManagementController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Button text="Back"
                    onAction="#backToDashboard"/>

            <Label text="Room Management"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TabPane>
            <tabs>

                <!-- View and delete rooms -->
                <Tab text="Rooms" closable="false">
                    <VBox spacing="10">
                        <padding>
                            <Insets top="10" right="15" bottom="15" left="15"/>
                        </padding>

                        <TableView fx:id="roomTable"
                                   prefHeight="300">
                            <columns>
                                <TableColumn fx:id="roomIdColumn"
                                             text="ID"
                                             prefWidth="60"/>

                                <TableColumn fx:id="roomNumberColumn"
                                             text="Room Number"
                                             prefWidth="130"/>

                                <TableColumn fx:id="floorNumberColumn"
                                             text="Floor"
                                             prefWidth="90"/>

                                <TableColumn fx:id="roomTypeColumn"
                                             text="Type"
                                             prefWidth="140"/>

                                <TableColumn fx:id="roomStatusColumn"
                                             text="Status"
                                             prefWidth="130"/>
                            </columns>
                        </TableView>

                        <HBox spacing="10">
                            <Button text="Refresh"
                                    onAction="#loadRooms"/>

                            <Button text="Delete Selected Room"
                                    onAction="#deleteRoom"/>
                        </HBox>

                        <Label fx:id="messageLabel"
                               wrapText="true"/>
                    </VBox>
                </Tab>

                <!-- Add a room -->
                <Tab text="Add Room" closable="false">
                    <GridPane hgap="10" vgap="15">
                        <padding>
                            <Insets top="30" right="60" bottom="30" left="60"/>
                        </padding>

                        <Label text="Room number:"
                               GridPane.rowIndex="0"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="roomNumberField"
                                   promptText="Example: 101"
                                   GridPane.rowIndex="0"
                                   GridPane.columnIndex="1"/>

                        <Label text="Floor number:"
                               GridPane.rowIndex="1"
                               GridPane.columnIndex="0"/>

                        <TextField fx:id="floorNumberField"
                                   promptText="Example: 1"
                                   GridPane.rowIndex="1"
                                   GridPane.columnIndex="1"/>

                        <Label text="Room type:"
                               GridPane.rowIndex="2"
                               GridPane.columnIndex="0"/>

                        <ComboBox fx:id="roomTypeBox"
                                  promptText="Select room type"
                                  GridPane.rowIndex="2"
                                  GridPane.columnIndex="1"/>

                        <Label text="Room status:"
                               GridPane.rowIndex="3"
                               GridPane.columnIndex="0"/>

                        <ComboBox fx:id="roomStatusBox"
                                  promptText="Select room status"
                                  GridPane.rowIndex="3"
                                  GridPane.columnIndex="1"/>

                        <Button text="Add Room"
                                onAction="#addRoom"
                                GridPane.rowIndex="4"
                                GridPane.columnIndex="1"/>
                    </GridPane>
                </Tab>

            </tabs>
        </TabPane>
    </center>
</BorderPane>