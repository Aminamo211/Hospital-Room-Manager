<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- Account creation screen -->
<VBox alignment="CENTER"
      prefHeight="600.0"
      prefWidth="640.0"
      spacing="10.0"
      xmlns="http://javafx.com/javafx/25.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="hospital_room_manager.CreateAccountController">

    <!-- Space around the form -->
    <padding>
        <Insets top="30" right="100" bottom="30" left="100"/>
    </padding>

    <!-- Screen title -->
    <Label text="Create Account"
           style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

    <!-- Account information -->
    <TextField fx:id="firstNameField"
               promptText="First name"
               maxWidth="300"/>

    <TextField fx:id="lastNameField"
               promptText="Last name"
               maxWidth="300"/>

    <ComboBox fx:id="roleBox"
              promptText="Select role"
              maxWidth="300"/>

    <DatePicker fx:id="dobPicker"
                promptText="Date of birth"
                maxWidth="300"/>

    <TextField fx:id="phoneField"
               promptText="Phone number"
               maxWidth="300"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="300"/>

    <PasswordField fx:id="passwordField"
                   promptText="Password"
                   maxWidth="300"/>

    <PasswordField fx:id="confirmPasswordField"
                   promptText="Confirm password"
                   maxWidth="300"/>

    <!-- Runs createAccount() in the controller -->
    <Button text="Create Account"
            maxWidth="300"
            onAction="#createAccount"/>

    <!-- Returns to primary.fxml -->
    <Button text="Back to Login"
            maxWidth="300"
            onAction="#backToLogin"/>

    <!-- Displays success and error messages -->
    <Label fx:id="messageLabel"
           wrapText="true"/>
</VBox>